generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hashed (sha256) single-use token for the "forgot password" flow, plus its
  // expiry. Both null when no reset is pending.
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  transactions          Transaction[]
  budgetGoals           BudgetGoal[]
  recurringTransactions RecurringTransaction[]

  @@map("users")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String           @id @default(uuid())
  type        TransactionType
  amount      Decimal          @db.Decimal(12, 2)
  category    String
  date        DateTime
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set only on rows materialized from a RecurringTransaction template (see
  // below). onDelete: SetNull means deleting the template stops future
  // generation but never touches transactions already generated from it —
  // they just lose the back-link.
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("transactions")
}

// A recurring monthly transaction template (rent, subscriptions, salary...)
// — not a ledger entry itself. Real Transaction rows are materialized from
// it lazily (see recurring.service.js: generateDueRecurringTransactions),
// on whatever request first needs up-to-date transaction data, rather than
// on a schedule — this app has no cron infra, and there's no benefit to
// generating before the user is actually looking at their data.
model RecurringTransaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  category    String
  description String?
  // Day of month (1-31) the occurrence should land on. Clamped to the last
  // day of shorter months (e.g. 31 -> Feb 28/29) at generation time.
  dayOfMonth Int
  startDate  DateTime
  // Inclusive last month this recurrence applies to; null = runs indefinitely.
  endDate    DateTime?
  active     Boolean   @default(true)
  // Calendar date of the last occurrence actually generated. Drives the
  // idempotent "catch up from here" logic — null means nothing generated yet.
  lastGeneratedDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
  @@map("recurring_transactions")
}

// One recurring monthly spending cap per category — not tied to a specific
// month, it's compared against whatever the current calendar month's
// EXPENSE total for that category is (see budgets.service.js). The unique
// constraint is a DB-level backstop; the app also pre-checks case-
// insensitively before insert (categories are free text, so "Mercado" and
// "mercado" would otherwise both slip through as "different" categories).
model BudgetGoal {
  id           String   @id @default(uuid())
  category     String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budget_goals")
}