# Postgres connection (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5433/fintrack?schema=public"

# Generate a strong random value for real environments, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="changeme-generate-a-strong-secret"
JWT_EXPIRES_IN="1d"

PORT=3333
CORS_ORIGIN="http://localhost:5173"
