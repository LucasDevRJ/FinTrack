# Postgres connection (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5433/fintrack?schema=public"

# Generate a strong random value for real environments, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="changeme-generate-a-strong-secret"
JWT_EXPIRES_IN="1d"

PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Resend (https://resend.com) — used to send password-reset e-mails.
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="FinTrack <onboarding@resend.dev>"

# Base URL of the frontend, used to build the password-reset link.
FRONTEND_URL="http://localhost:5173"
